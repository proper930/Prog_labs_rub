#include <stdio.h>
#include <locale.h>
#include <math.h>
int main() {
	setlocale(LC_ALL, "RUS");
	double x = 1.0;
	double h = 0.001;
	double y1 = ((x + 2 * h) * (x + 2 * h) + 3 * (x + 2 * h) + 1) * exp(3 * (x + 2 * h) + 2);
	double y2 = ((x + h) * (x + h) + 3 * (x + h) + 1) * exp(3 * (x + h) + 2);
	double y3 = ((x - h) * (x - h) + 3 * (x - h) + 1) * exp(3 * (x - h) + 2);
	double y4 = ((x - 2 * h) * (x - 2 * h) + 3 * (x - 2 * h) + 1) * exp(3 * (x - 2 * h) + 2);
	double otvet = (y1 - 2 * y2 + 2 * y3 - y4) / (2 * h * h * h);
	printf("Ответ %f\n", otvet);

}
