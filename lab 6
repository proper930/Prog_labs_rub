#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "RUS");

    const int MIN = 1;
    const int MAX = 100;
    const int EVENTS = 10;
    const int NAME_LEN = 50;

    int n;
    int scores[MAX][EVENTS];       // баллы по 10 видам
    char surnames[MAX][NAME_LEN];  // фамилии спортсменов
    int total[MAX];                // сумма баллов каждого спортсмена
    int index[MAX];                // номера

    do {
        printf("Введите количество спортсменов N (от %d до %d): ", MIN, MAX);
        if (scanf("%d", &n) != 1) {
            printf("Ошибка ввода\n");
            return 1;
        }
    } while (n < MIN || n > MAX);

    printf("\nВведите фамилии спортсменов (без пробелов):\n");
    for (int i = 0; i < n; i++) {
        printf("Спортсмен %d: ", i + 1);
        scanf("%49s", surnames[i]);

        index[i] = i; 
        total[i] = 0;

        for (int j = 0; j < EVENTS; j++) {
            scores[i][j] = 500 + rand() % 501;
            total[i] += scores[i][j];
        }
    }

    printf("\nИсходные результаты по 10 видам:\n");
    for (int i = 0; i < n; i++) {
        printf("%-15s | ", surnames[i]);
        for (int j = 0; j < EVENTS; j++) {
            printf("%4d ", scores[i][j]);
        }
        printf("| Сумма: %d\n", total[i]);
    }

    
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (total[index[j]] < total[index[j + 1]]) {
                int temp = index[j];
                index[j] = index[j + 1];
                index[j + 1] = temp;
            }
        }
    }

    printf("\nИтоговый протокол (в порядке занятых мест):\n");
    for (int i = 0; i < n; i++) {
        int k = index[i]; 
        printf("%d место: %-15s — %d баллов\n", i + 1, surnames[k], total[k]);
    }

    return 0; 
}


