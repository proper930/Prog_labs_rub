#define _CRT_SECURE_NO_WARNINGS 
#include <stdio.h>
#include <locale.h> 

int main() {
    setlocale(LC_ALL, "RU");

    int n;//k troek
    int k = 0;
    double a, b, c;

   
    while (1) {
        printf("Введите количество троек чисел (N): ");

        
        if (scanf("%d", &n) == 1 && n > 0) {
            break;
        }

        printf("Ошибка: нужно ввести целое число больше 0. Попробуйте снова.\n\n");

        while (getchar() != '\n');
    }

    
    for (int i = 1; i <= n; i++) {

        while (1) {
            printf("Тройка #%d (введите 3 положительных числа через пробел): ", i);

            if (scanf("%lf%lf%lf", &a, &b, &c) == 3 && a > 0 && b > 0 && c > 0) {
                break;
            }


            printf("Ошибка: стороны должны быть числами больше 0. Попробуйте снова.\n\n");
            while (getchar() != '\n'); 
        }

        
        if (a + b > c && a + c > b && b + c > a) {
            k++;
        }
    }

    
    printf("\nРезультат: из %d троек можно составить %d треугольник(ов).\n", n, k);

    return 0;
}
