#include <stdio.h>

struct Student {
    char surname;
    char name;
    int day, month, year;
    int fiz, mat, inf;
};

int main() {
    const int N = 3;
    struct Student st, temp;

    for (int i = 0; i < N; i++) {
        printf("Student %d (Surname, Name): ", i + 1);
        scanf("%s %s", st[i].surname, st[i].name);
        printf("Birthday (d m y): ");
        scanf("%d %d %d", &st[i].day, &st[i].month, &st[i].year);
        printf("Marks (fiz mat inf): ");
        scanf("%d %d %d", &st[i].fiz, &st[i].mat, &st[i].inf);
    }

    printf("\nTable:\n");
    for (int i = 0; i < N; i++) {
        printf("%s %s | %02d.%02d.%d | %d %d %d\n",
               st[i].surname, st[i].name, st[i].day, st[i].month, st[i].year,
               st[i].fiz, st[i].mat, st[i].inf);
    }

    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - i - 1; j++) {
            if (st[j].fiz > st[j + 1].fiz) {
                temp = st[j];
                st[j] = st[j + 1];
                st[j + 1] = temp;
            }
        }
    }

    printf("\nResult:\n");
    for (int i = 0; i < N; i++) {
        printf("%s %s | %02d.%02d.%d | %d %d %d\n",
               st[i].surname, st[i].name, st[i].day, st[i].month, st[i].year,
               st[i].fiz, st[i].mat, st[i].inf);
    }

    return 0;
}
