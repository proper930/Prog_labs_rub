#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>

#include <locale.h>
struct Student {
	char surname[50];
	char name[50];
	int day, month, year;
	int fiz, mat, inf;
};
int main() {
	setlocale(LC_ALL, "RUS");
	const int MAX = 100;
	struct Student st[MAX], temp;
	int n;
	do {
		printf("Введите количесто студентов:");
		scanf("%d", &n);
		if (n <= 0 || n > MAX) {
			printf("Ошибка! Число должно быть от 1 до %d. Попробуйте снова.\n", MAX);
		}
	} while (n <= 0 || n > MAX);

	for (int i = 0; i < n;i++) {
		printf("введите информацию про %d- студента \n", i + 1);
		printf("фамилия:");
		scanf("%49s", st[i].surname);
		printf("имя: ");
		scanf("%49s", st[i].name);
		printf("День рождение(день, месяц, год): ");
		scanf("%d %d %d", &st[i].day, &st[i].month, &st[i].year);
		printf("баллы: ");
		scanf("%d %d %d", &st[i].fiz, &st[i].mat, &st[i].inf);
	}
	printf("\n%-15s %-15s %-15s %s\n", "Фамилия", "Имя", "День рождения", "Баллы" );
	for (int i = 0;i < n;i++) {
		printf("%-15s %-15s %02d.%02d.%04d        %d %d %d\n", st[i].surname, st[i].name, st[i].day, st[i].month, st[i].year, st[i].fiz, st[i].mat, st[i].inf);

	}
	for (int i = 0;i < n - 1;i++) {
		for (int j = 0;j < n - i - 1;j++) {
			if (st[j].fiz > st[j + 1].fiz) {
				temp = st[j];
				st[j] = st[j + 1];
				st[j + 1] = temp;
			}
		}
	}
	printf("\nРeзультат:\n");
	printf("\n%-15s %-15s %-15s %s\n", "Фамилия", "Имя", "День рождения", "Баллы");
	for (int i = 0;i < n;i++) {
		printf("%-15s %-15s %02d.%02d.%04d         %d %d %d\n", st[i].surname, st[i].name, st[i].day, st[i].month, st[i].year, st[i].fiz, st[i].mat, st[i].inf);
	}
	return 0;
}
