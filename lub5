#define _CRT_SECURE_NO_WARNINGS // Отключаем ругань Visual Studio на scanf
#include <stdio.h>
#include <stdlib.h> // Библиотека для функции rand()
#include <locale.h> // Библиотека для русского языка

int main() {
    setlocale(LC_ALL, "Russian"); // Включаем русский язык

    // Задаем размер массива через обычную константную переменную
    const int SIZE = 100; 

    double arr[SIZE]; // Основной массив на 100 элементов
    double res[SIZE]; // Массив для результатов (тоже на 100)

    // 1. Заполняем массив случайными числами
    printf("Исходный массив:\n");
    for (int i = 0; i < SIZE; i++) {
        // Упрощенная формула генерации дробных чисел от -15 до 38
        arr[i] = -15.0 + ((double)rand() / RAND_MAX) * 53.0; 
        printf("%.2f  ", arr[i]);
    }
    printf("\n\n");

    // 2. Отбираем нужные элементы
    int k = 0; // Счетчик подходящих чисел

    // Шаг i += 2 сразу перебирает только четные индексы (0, 2, 4...)
    for (int i = 0; i < SIZE; i += 2) {
        if (arr[i] > 0) { // Если число положительное
            res[k] = arr[i]; // Переписываем его в массив результатов
            k++; // Считаем его
        }
    }

    // 3. Простая сортировка пузырьком
    for (int i = 0; i < k - 1; i++) {
        for (int j = 0; j < k - i - 1; j++) {
            if (res[j] > res[j + 1]) {
                // Обмен местами через временную переменную t
                double t = res[j];
                res[j] = res[j + 1];
                res[j + 1] = t;
            }
        }
    }

    // 4. Выводим результат
    printf("Положительные элементы на четных позициях (по возрастанию):\n");
    if (k == 0) {
        printf("Таких элементов не найдено.\n");
    } else {
        for (int i = 0; i < k; i++) {
            printf("%.2f  ", res[i]);
        }
        printf("\n");
    }

    // Задерживаем экран с помощью простейшей функции getchar()
    // Она просто ждет нажатия любой клавиши Enter, без создания переменных
    printf("\nНажмите Enter для выхода...");
    getchar(); 
    getchar(); 

    return 0;
}
