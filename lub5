#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");
    int N;
    double arr[100];
    double res[100];

    do {
        printf("Введите размер массива (от 1 до 100): ");
        if (scanf("%d", &N) != 1) {
            printf("Ошибка ввода текста!\n");
            return 1;
        }
    } while (N < 1 || N > 100);

    printf("\nИсходный массив:\n");
    for (int i = 0; i < N; i++) {
        arr[i] = -15.0 + ((double)rand() / RAND_MAX) * 53.0;
        printf("%.2f ", arr[i]);
    }
    printf("\n\n");

    int k = 0;
    for (int i = 0; i < N; i += 2) {
        if (arr[i] > 0) {
            res[k] = arr[i];
            k++;
        }
    }

    for (int i = 0; i < k; i++) {
        for (int j = i + 1; j < k; j++) {
            if (res[i] > res[j]) {
                double t = res[i];
                res[i] = res[j];
                res[j] = t;
            }
        }
    }

    printf("Положительные элементы на четных позициях (по возрастанию):\n");
    if (k == 0) {
        printf("Таких элементов не найдено.\n");
    }
    else {
        for (int i = 0; i < k; i++) {
            printf("%.2f ", res[i]);
        }
        printf("\n");
    }

    return 0;
}
